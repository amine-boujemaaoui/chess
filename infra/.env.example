# Copier ce fichier en infra/.env et remplir les valeurs vides.
# Il est lu par Docker Compose et par game-service lancé en local.
POSTGRES_DB=chess
POSTGRES_USER=chess
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Clé de signature des jetons JWT, au moins 32 caractères. Par exemple : openssl rand -base64 48
JWT_SECRET=
